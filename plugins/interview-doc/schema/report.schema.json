{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "interview-doc report",
  "type": "object",
  "required": ["meta", "speakers", "chapters"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "lang": { "type": "string", "default": "ko" },
        "docTitle": { "type": "string", "description": "브라우저 탭 제목. 없으면 title 사용" },
        "kicker": { "type": "string", "description": "제목 위 소형 라벨 (예: User Interview · Annotated)" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "facts": {
          "type": "array",
          "description": "상단 사실 스트립. 4~6개 권장",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": { "label": { "type": "string" }, "value": { "type": "string" } }
          }
        },
        "lede": { "type": "string", "description": "이 인터뷰의 결론 한 덩어리. 2~4문장" },
        "navHead": { "type": "string", "default": "Contents" },
        "bcLabel": { "type": "string", "default": "맞장구·간투사 숨기기" }
      }
    },

    "speakers": {
      "type": "array",
      "minItems": 1,
      "description": "tone은 primary(주인공=인터뷰이) 1명, 나머지는 muted. 3인 이상일 때만 alt 사용",
      "items": {
        "type": "object",
        "required": ["key", "label", "tone"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string", "description": "화면에 표시되는 이름. 역할명 권장 (교사, 진행자, PM)" },
          "tone": { "enum": ["primary", "muted", "alt"] }
        }
      }
    },

    "strip": {
      "description": "리드 아래 시각 요소. 하나만. 없으면 생략",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "items"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "timeline" },
            "heading": { "type": "string" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["when", "what"],
                "additionalProperties": false,
                "properties": {
                  "when": { "type": "string" },
                  "what": { "type": "string" },
                  "hot": { "type": "boolean", "description": "강조 노드. 전체의 절반 이하로" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "html"],
          "additionalProperties": false,
          "properties": { "type": { "const": "raw" }, "html": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": { "type": { "const": "none" } }
        }
      ]
    },

    "chapters": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": { "$ref": "#/definitions/chapter" }
    },

    "closing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "default": "end" },
        "title": { "type": "string" },
        "navLabel": { "type": "string" },
        "turns": { "type": "array", "items": { "$ref": "#/definitions/turn" } },
        "analysis": {
          "oneOf": [
            { "$ref": "#/definitions/analysis" },
            { "type": "array", "items": { "$ref": "#/definitions/analysis" } }
          ]
        },
        "table": { "$ref": "#/definitions/table" },
        "followups": {
          "type": "object",
          "required": ["items"],
          "additionalProperties": false,
          "properties": {
            "heading": { "type": "string", "default": "Follow-up" },
            "items": { "type": "array", "items": { "type": "string" } }
          }
        },
        "footnote": { "type": "string", "description": "전사 처리 방식 고지. 무엇을 손댔고 무엇을 안 손댔는지" }
      }
    }
  },

  "definitions": {
    "chapter": {
      "type": "object",
      "required": ["id", "title", "turns"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "num": { "type": "string", "description": "표시용 번호. 01, 02 …" },
        "navNum": { "type": "string" },
        "navLabel": { "type": "string", "description": "목차용 짧은 이름. 제목이 길 때만" },
        "title": { "type": "string" },
        "lede": { "type": "string", "description": "이 챕터에서 무슨 일이 일어나는가. 1~2문장" },
        "flow": {
          "type": "object",
          "required": ["lead"],
          "additionalProperties": false,
          "description": "대화의 흐름. 누가 화제를 꺼냈고 어디서 이어졌는지",
          "properties": {
            "lead": { "type": "string", "description": "예: 교사가 먼저 꺼냄 / 진행자 질문" },
            "detail": { "type": "string" }
          }
        },
        "marker": { "type": "string", "description": "구간 표식. 녹취 시작, 화제 전환, 휴식 등" },
        "turns": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/turn" } },
        "analysis": {
          "oneOf": [
            { "$ref": "#/definitions/analysis" },
            { "type": "array", "items": { "$ref": "#/definitions/analysis" } }
          ]
        }
      }
    },

    "turn": {
      "oneOf": [
        {
          "type": "object",
          "required": ["who", "paras"],
          "additionalProperties": false,
          "properties": {
            "who": { "type": "string", "description": "speakers[].key" },
            "paras": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "bc": { "type": "boolean", "description": "맞장구·간투사. 접힘 대상" },
            "note": { "type": "string", "description": "마진 주석. 관찰→해석→함의. 전체 turn의 30~50%에만" }
          }
        },
        {
          "type": "object",
          "required": ["raw"],
          "additionalProperties": false,
          "properties": { "raw": { "type": "string", "description": "탈출구. 정의된 CSS class만 사용, style= 금지" } }
        }
      ]
    },

    "analysis": {
      "type": "object",
      "required": ["title", "blocks"],
      "additionalProperties": false,
      "properties": {
        "tag": { "type": "string", "description": "Analysis / Verdict 등" },
        "title": { "type": "string", "description": "판단을 담은 한 문장. 주제 나열 금지" },
        "className": { "type": "string" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "type": "object", "required": ["p"], "additionalProperties": false, "properties": { "p": { "type": "string" } } },
              {
                "type": "object",
                "required": ["list"],
                "additionalProperties": false,
                "properties": {
                  "list": {
                    "type": "object",
                    "required": ["items"],
                    "additionalProperties": false,
                    "properties": {
                      "ordered": { "type": "boolean" },
                      "items": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                }
              },
              { "type": "object", "required": ["verdict"], "additionalProperties": false, "properties": { "verdict": { "type": "string" } } },
              { "type": "object", "required": ["raw"], "additionalProperties": false, "properties": { "raw": { "type": "string" } } }
            ]
          }
        }
      }
    },

    "table": {
      "type": "object",
      "required": ["headers", "rows"],
      "additionalProperties": false,
      "description": "대조표. 축은 렌즈마다 다르게 정한다",
      "properties": {
        "headers": { "type": "array", "items": { "type": "string" } },
        "cellClasses": { "type": "array", "items": { "type": "string" }, "description": "열별 기본 class. 첫 열 강조는 \"w\"" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cells"],
            "additionalProperties": false,
            "properties": {
              "rank": { "type": "string", "description": "행 번호. 있으면 좌측에 별도 열" },
              "cells": {
                "type": "array",
                "items": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "required": ["t"],
                      "additionalProperties": false,
                      "properties": { "t": { "type": "string" }, "cls": { "type": "string" } }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
